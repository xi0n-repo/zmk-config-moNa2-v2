#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <8 7>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <1 2>;
        };

        bs {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q               &kp W             &kp E       &kp R         &kp T                                                            &kp Y        &kp U  &kp I      &kp O         &lt 7 P
&mt LEFT_CONTROL A  &kp S             &kp D       &kp F         &kp G                                &kp F13                     &kp H        &kp J  &kp K      &kp L         &mt RIGHT_CONTROL MINUS
&mt LEFT_SHIFT Z    &lt 3 X           &kp C       &kp V         &kp B        &none                   &none                       &kp N        &kp M  &kp COMMA  &lt 3 PERIOD  &mt RIGHT_SHIFT SLASH
&kp LEFT_WIN        &kp LEFT_CONTROL  &kp ESCAPE  &kp LEFT_ALT  &lt 4 SPACE  &lt_to_layer_0 2 TAB    &lt_to_layer_0 5 BACKSPACE  &lt 3 ENTER                                  &kp RIGHT_ALT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&to_layer_0 Q       &to_layer_0 W  &to_layer_0 E  &to_layer_0 R  &to_layer_0 T                    &to_layer_0 Y  &to_layer_0 U  &to_layer_0 I      &to_layer_0 O  &lt 7 P
&mt LEFT_CONTROL A  &to_layer_0 S  &mkp MB2       &mkp MB1       &to_layer_0 G            &trans  &to_layer_0 H  &mkp MB1       &mkp MB2           &to_layer_0 L  &mt RIGHT_CONTROL MINUS
&mt LEFT_SHIFT Z    &lt 3 X        &to_layer_0 C  &to_layer_0 V  &to_layer_0 B  &trans    &trans  &to_layer_0 N  &to_layer_0 M  &to_layer_0 COMMA  &lt 3 PERIOD   &mt RIGHT_SHIFT SLASH
&kp LEFT_GUI        &trans         &kp ESCAPE     &kp LEFT_ALT   &trans         &trans    &trans  &trans                                                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        CURSOR {
            bindings = <
&kp ESCAPE        &none   &none     &none     &none                            &none          &none           &kp UP_ARROW    &none            &none
&kp LEFT_CONTROL  &none   &mkp MB2  &mkp MB1  &kp LEFT_ALT            &trans   &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none
&kp LEFT_SHIFT    &none   &none     &none     &none         &trans    &trans   &kp PAGE_DOWN  &kp HOME        &kp END         &none            &none
&trans            &trans  &trans    &trans    &trans        &trans    &kp DEL  &trans                                                          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        FUNCTION {
            bindings = <
&kp ESCAPE        &kp F2  &kp F3     &kp F4        &kp F5                           &kp F6   &kp F7     &kp F8     &kp F9  &kp F10
&kp LEFT_CONTROL  &none   &mkp RCLK  &mkp LCLK     &none             &trans         &kp F12  &mkp LCLK  &mkp RCLK  &none   &kp RIGHT_CONTROL
&kp LEFT_SHIFT    &none   &none      &none         &none   &trans    &trans         &none    &none      &none      &none   &kp RIGHT_SHIFT
&trans            &trans  &trans     &kp LEFT_ALT  &trans  &trans    &kp BACKSPACE  &trans                                 &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        NUMBER {
            bindings = <
&kp NUMBER_1              &kp NUMBER_2  &kp NUMBER_3     &kp NUMBER_4  &kp NUMBER_5                           &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&mt LEFT_CONTROL KP_PLUS  &kp KP_MINUS  &kp KP_ASTERISK  &kp KP_SLASH  &kp EQUAL               &trans         &kp RIGHT_ALT  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RIGHT_CONTROL
&kp LEFT_SHIFT            &none         &none            &none         &kp LEFT_ALT  &trans    &trans         &kp NUMBER_0   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &mt RIGHT_SHIFT PERIOD
&trans                    &trans        &trans           &trans        &trans        &trans    &kp BACKSPACE  &kp ENTER                                                &trans
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        MARK {
            bindings = <
&kp EXCLAMATION   &kp AT  &kp HASH   &kp DOLLAR  &kp PERCENT                    &kp CARET      &kp AMPERSAND     &kp ASTERISK       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LEFT_CONTROL  &none   &kp MINUS  &kp EQUAL   &kp GRAVE              &trans  &kp BACKSLASH  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON         &mt RIGHT_CONTROL SINGLE_QUOTE
&kp LEFT_SHIFT    &none   &none      &none       &none        &trans    &trans  &none          &none             &kp COMMA          &kp PERIOD            &mt RIGHT_SHIFT SLASH
&trans            &trans  &trans     &trans      &kp SPACE    &trans    &trans  &trans                                                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                  &trans  &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &trans  &studio_unlock  &trans        &trans        &trans        &bt BT_CLR_ALL
&trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans                                                    &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&kp LC(LG(D))     &kp LC(LG(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LC(LG(RIGHT_ARROW))  &trans                                &trans         &trans          &kp UP_ARROW    &trans           &trans
&kp LEFT_CONTROL  &kp LG(LEFT_ARROW)      &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)      &trans                    &trans      &kp PAGE_UP    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&kp LEFT_SHIFT    &trans                  &trans              &trans                   &kp LC(LG(F4))  &trans    &trans      &kp PAGE_DOWN  &kp HOME        &kp END         &trans           &trans
&trans            &trans                  &trans              &trans                   &trans          &trans    &kp DELETE  &trans                                                          &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        wireless {
            if-layers = <2 3>;
            then-layer = <6>;
        };
    };
};
